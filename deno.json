{
  "name": "@dreamer/render",
  "version": "1.3.0",
  "description": "A rendering library for SSR, CSR, Hydration, and SSG, supporting React, Preact, and View.",
  "license": "Apache-2.0",
  "exports": {
    ".": "./src/mod.ts",
    "./client": "./src/client/mod.ts",
    "./client/preact": "./src/client/adapters/preact.ts",
    "./client/react": "./src/client/adapters/react.ts",
    "./client/view": "./src/client/adapters/view.ts",
    "./client/view-csr": "./src/client/adapters/view-csr.ts",
    "./client/view-hybrid": "./src/client/adapters/view-hybrid.ts"
  },
  "publish": {
    "include": [
      "src/**/*.ts",
      "src/locales/*.json",
      "package.json",
      "LICENSE",
      "NOTICE",
      "README.md"
    ],
    "exclude": [
      "**/*.test.ts",
      "**/*.spec.ts",
      "**/test/**",
      "**/tests/**"
    ]
  },
  "tasks": {
    "test": "deno test -A --minimum-dependency-age=0 --no-check tests/",
    "test:node": "node --import tsx --test-force-exit test-node.mjs",
    "check": "deno check src/mod.ts",
    "lint": "deno lint src/",
    "fmt": "deno fmt src/ tests/"
  },
  "lint": {
    "include": [
      "src/"
    ],
    "rules": {
      "tags": [
        "recommended"
      ],
      "exclude": [
        "no-explicit-any"
      ]
    }
  },
  "imports": {
    "@dreamer/i18n": "jsr:@dreamer/i18n@^1.1.2",
    "@dreamer/runtime-adapter": "jsr:@dreamer/runtime-adapter@^1.2.2",
    "@dreamer/test": "jsr:@dreamer/test@^1.2.3",
    "@dreamer/view": "jsr:@dreamer/view@^2.2.0",
    "react": "npm:react@^19.2.6",
    "react-dom": "npm:react-dom@^19.2.6",
    "scheduler": "npm:scheduler@^0.27.0",
    "preact": "npm:preact@^10.29.2",
    "preact-render-to-string": "npm:preact-render-to-string@^6.6.7",
    "happy-dom": "npm:happy-dom@^20.9.0"
  },
  "nodeModulesDir": "auto",
  "minimumDependencyAge": "0",
  "compilerOptions": {
    "lib": [
      "deno.window",
      "dom"
    ],
    "jsx": "react-jsx",
    "jsxImportSource": "@dreamer/view"
  },
  "allowScripts": {
    "allow": [],
    "deny": [
      "npm:esbuild@0.27.2",
      "npm:puppeteer@24.36.1"
    ]
  }
}
